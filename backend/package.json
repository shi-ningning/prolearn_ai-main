{
  "name": "prolearn-ai-backend",
  "version": "1.0.0",
  "description": "Backend services for ProLearnAI - REST API and Cloud Functions",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "dev:functions": "cd src/functions && npm run serve",
    "build:functions": "cd src/functions && npm run build",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "emulators": "firebase emulators:start",
    "db:seed": "cd src/database/firestore/seed && npx ts-node seed-data.ts"
  },
  "keywords": [
    "backend",
    "api",
    "express",
    "typescript",
    "firebase",
    "cloud-functions"
  ],
  "author": "ProLearnAI Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.3",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "prisma": "^5.8.0",
    "rate-limiter-flexible": "^5.0.0",
    "redis": "^4.6.12"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
